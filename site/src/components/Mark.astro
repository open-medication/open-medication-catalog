---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" class={className} aria-hidden="true">
  <rect width="32" height="32" rx="7" fill="currentColor" />
  <rect x="7" y="7" width="18" height="18" rx="2.5" fill="var(--color-paper)" />
  <path d="M10 12.5h12M10 16h12M10 19.5h7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <rect x="18.2" y="18.4" width="6.4" height="3.4" rx="1.7" fill="var(--color-brass)" />
</svg>
