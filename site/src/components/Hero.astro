---
import { GITHUB_URL } from "../lib/site.ts";
import IconArrowUpRight from "./IconArrowUpRight.astro";
---

<section class="hero">
  <div class="container">
    <h1 class="h1">Open Medication Catalog</h1>
    <p class="lede">
      A multi-national medication catalog based on open data sources, with stable and
      reproducible FHIR R4, FHIR R5 (IDMP) and SQLite releases.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#download">Download artifacts</a>
      <a class="btn btn-secondary" href={GITHUB_URL} target="_blank" rel="noreferrer">
        Source on GitHub
        <IconArrowUpRight />
      </a>
    </div>
    <p class="hero-note body-text">
      The generator is Apache-2.0. Each dataset keeps its upstream licence and attribution.
      Attributions are recorded in the release.
    </p>
  </div>
</section>

<style>
  .hero {
    padding: 5.5rem 0 4rem;
  }

  .hero .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero-note {
    font-size: 0.95rem;
  }

  @media screen and (max-width: 720px) {
    .hero {
      padding: 3.5rem 0 2.5rem;
    }
  }
</style>
