---
import bakedCatalog from "../../public/catalog.json" with { type: "json" };
import { CATALOG_PATH, GITHUB_RELEASES_URL } from "../lib/site.ts";
import {
  ARTIFACT_META,
  formatDataMonth,
  parseCatalogDoc,
  zipUrl,
  type CatalogArtifact,
} from "../lib/catalog.ts";
import { sourcesForArtifact } from "../lib/licences.ts";
import IconArrowUpRight from "./IconArrowUpRight.astro";
import LicenceFlags from "./LicenceFlags.astro";

const catalog = parseCatalogDoc(bakedCatalog);

const cards = ARTIFACT_META.map((meta) => {
  const entry: CatalogArtifact | undefined = catalog.artifacts[meta.id];
  return { meta, entry, sources: sourcesForArtifact(meta.id) };
});
---

<section class="section" id="download">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Releases</p>
      <h2 class="h2">Download the latest artifacts</h2>
      <p class="body-text">
        Monthly zips are published at the
        <a class="inline-link" href={GITHUB_RELEASES_URL}>GitHub Releases</a>
        page or can be downloaded below. A machine-parsable catalog can be found at
        <a class="inline-link" href={CATALOG_PATH}><code class="mono">catalog.json</code></a>.
      </p>
    </div>

    <div class="download-grid">
      {cards.map(({ meta, entry, sources }) => (
        <article class="card download-card" data-artifact={meta.id}>
          <div class="download-top">
            <p class="eyebrow">{meta.jurisdiction}</p>
            <span class:list={["pill", entry ? "pill-brass" : "pill-muted"]} data-role="month">
              {entry ? formatDataMonth(entry.latest) : "Not yet published"}
            </span>
          </div>
          <h3 class="h3">{meta.title}</h3>
          <p class="mono artifact-id">{meta.id}</p>
          <p class="body-text">{meta.blurb}</p>
          <div class="licence-stack">
            {sources.map((source) => (
              <LicenceFlags source={source} />
            ))}
          </div>
          <div class="download-actions">
            <div class="published-actions" data-role="published" hidden={!entry}>
              <a class="btn btn-primary" data-role="zip" href={entry ? zipUrl(entry) : "#"}>
                Download zip
              </a>
              <a class="btn btn-secondary" data-role="manifest" href={entry?.manifest ?? "#"}>
                manifest.json
              </a>
              <a
                class="ghost-link"
                data-role="notes"
                href={entry?.url ?? "#"}
                target="_blank"
                rel="noreferrer"
              >
                Release notes
                <IconArrowUpRight />
              </a>
            </div>
            <p class="body-text empty-note" data-role="empty" hidden={Boolean(entry)}>
              No public zip for <code class="mono">{meta.id}</code> yet.
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { fetchCatalog, formatDataMonth, zipUrl, type CatalogArtifact } from "../lib/catalog.ts";

  function applyCatalogToCard(card: HTMLElement, entry: CatalogArtifact | undefined): void {
    const pill = card.querySelector("[data-role=month]");
    const published = card.querySelector("[data-role=published]");
    const empty = card.querySelector("[data-role=empty]");
    const zip = card.querySelector<HTMLAnchorElement>("[data-role=zip]");
    const manifest = card.querySelector<HTMLAnchorElement>("[data-role=manifest]");
    const notes = card.querySelector<HTMLAnchorElement>("[data-role=notes]");
    if (!(pill instanceof HTMLElement) || !(published instanceof HTMLElement) || !(empty instanceof HTMLElement)) {
      return;
    }
    if (entry) {
      pill.textContent = formatDataMonth(entry.latest);
      pill.classList.add("pill-brass");
      pill.classList.remove("pill-muted");
      published.hidden = false;
      empty.hidden = true;
      if (zip) zip.href = zipUrl(entry);
      if (manifest) manifest.href = entry.manifest;
      if (notes) notes.href = entry.url;
    } else {
      pill.textContent = "Not yet published";
      pill.classList.add("pill-muted");
      pill.classList.remove("pill-brass");
      published.hidden = true;
      empty.hidden = false;
    }
  }

  const cards = document.querySelectorAll<HTMLElement>("[data-artifact]");
  fetchCatalog()
    .then((doc) => {
      for (const card of cards) {
        const id = card.dataset.artifact;
        if (!id) continue;
        applyCatalogToCard(card, doc.artifacts[id]);
      }
    })
    .catch((err: unknown) => {
      console.warn("Could not refresh catalog.json", err);
    });
</script>

<style>
  .download-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.5rem 1.4rem 1.35rem;
  }

  .download-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .artifact-id {
    margin: 0;
    color: var(--color-brass);
  }

  .licence-stack {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .download-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .published-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .published-actions[hidden],
  .empty-note[hidden] {
    display: none;
  }

  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
  }

  .ghost-link svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .empty-note {
    font-size: 0.9rem;
  }

  @media screen and (max-width: 800px) {
    .download-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
