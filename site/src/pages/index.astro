---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Downloads from "../components/Downloads.astro";
import About from "../components/About.astro";
import Coverage from "../components/Coverage.astro";
import Limits from "../components/Limits.astro";
import Build from "../components/Build.astro";
import Licence from "../components/Licence.astro";
import Sponsor from "../components/Sponsor.astro";
import Footer from "../components/Footer.astro";
import {
  DESCRIPTION,
  GITHUB_URL,
  OG_IMAGE_ALT,
  OG_IMAGE_PATH,
  SITE_URL,
  TITLE,
} from "../lib/site.ts";

const ogImage = new URL(OG_IMAGE_PATH, SITE_URL).href;
const logo = new URL("/favicon-192.png", SITE_URL).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: TITLE,
  applicationCategory: "HealthApplication",
  operatingSystem: "Any",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  url: SITE_URL,
  description: DESCRIPTION,
  codeRepository: GITHUB_URL,
  isAccessibleForFree: true,
  image: ogImage,
  screenshot: ogImage,
  logo: {
    "@type": "ImageObject",
    url: logo,
    caption: OG_IMAGE_ALT,
  },
};
---

<Layout structuredData={structuredData}>
  <Navbar />
  <main id="content">
    <Hero />
    <hr class="section-rule container" />
    <Downloads />
    <About />
    <Coverage />
    <Limits />
    <Build />
    <Licence />
    <Sponsor />
  </main>
  <Footer />
</Layout>
