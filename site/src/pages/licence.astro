---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { GITHUB_URL } from "../lib/site.ts";
import { allSourceLicences, attributionLabel } from "../lib/licences.ts";

const sources = allSourceLicences();
---

<Layout
  title="Licence"
  description="Apache-2.0 for the generator. Upstream terms and attribution for each national dataset, recorded in every release zip."
>
  <Navbar />
  <main id="content" class="section">
    <article class="container licence-page">
      <p class="eyebrow">Licence</p>
      <h1 class="h1">Generator and dataset licences</h1>
      <p class="lede">
        The generator is Apache-2.0. The medicinal-product data keeps its upstream licence and attribution.
      </p>

      <h2 class="h2">Generator</h2>
      <p class="body-text">
        The CLI, adapters, schemas, and Implementation Guide sources are licensed under the
        <a class="inline-link" href={`${GITHUB_URL}/blob/main/LICENSE`}>Apache License 2.0</a>.
      </p>

      <h2 class="h2">Published datasets</h2>
      <p class="body-text">
        Generated SQLite and FHIR files keep the terms of the national sources they were built from,
        including attribution. Those terms are checksummed at build time. A material change on an
        upstream terms page blocks official redistribution until the snapshot is reviewed.
      </p>
      <p class="body-text">
        The flags below are indicators of our interpretation of the linked terms at the dated review.
        They are not a licence grant. See the
        <a class="inline-link" href="/#licence">licence section</a> for the rubric and disclaimer.
      </p>
      <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Source</th>
            <th>commercialUse</th>
            <th>redistribution</th>
            <th>attributionRequired</th>
            <th>Terms</th>
          </tr>
        </thead>
        <tbody>
          {sources.map((source) => (
            <tr>
              <td>{source.label}</td>
              <td class="mono">{source.commercialUse}</td>
              <td class="mono">{source.redistribution}</td>
              <td class="mono">{attributionLabel(source.attributionRequired)}</td>
              <td>
                <a class="inline-link" href={source.termsUrl} target="_blank" rel="noreferrer">
                  Upstream terms
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <p class="body-text">
        Each release zip includes <code class="mono">manifest.json</code> and a
        <code class="mono">licensing/</code> directory with the same flags, URLs, checksums, and
        disclaimer.
      </p>

      <h2 class="h2">This website</h2>
      <p class="body-text">
        The landing page is static. It does not set cookies or load analytics. Fonts are self-hosted.
      </p>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .licence-page {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .licence-page .h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .licence-page .h2 {
    margin-top: 1.25rem;
    font-size: 1.35rem;
  }

  .table-wrap {
    overflow-x: auto;
  }
</style>
